    "GAIN_FOR_RAID",
    "GAIN_FOR_CLAIM",
    "GAIN_FOR_WATCH",
    "GAIN_FOR_WATCH_STREAK",
    "BET_WIN",
    "BET_LOSE",
    "BET_REFUND",
    "BET_FILTERS",
    "BET_GENERAL",
    "BET_FAILED",
    "BET_START",
    "BONUS_CLAIM",
    "MOMENT_CLAIM",
    "JOIN_RAID",
    "DROP_CLAIM",
    "DROP_CLAIM_AVAILABLE",
    "DROP_STATUS",
    "CHAT_MENTION",
    "GIFTED_SUB",
    "MINER_STARTED",
    "MINER_STOPPED",
    "MINER_CRASHED",
    "ACCOUNT_CONFIG_RELOADED",
    "DROP_MILESTONE",
