  ],
  "defaults": {
    "badge_watcher_poll_interval": "5m",
    "badge_watcher_streamer_limit": 1,
    "bet": {
      "delay": 6,
      "delay_mode": "FROM_END",
      "max_points": 50000,
      "minimum_points": 0,
      "percentage": 5,
      "percentage_gap": 20,
      "stealth_mode": false,
      "strategy": "SMART"
    },
    "category_watcher_poll_interval": "120s",
    "chat": "ONLINE",
    "claim_drops": true,
    "claim_moments": true,
    "follow_raid": true,
    "followers_order": "ASC",
    "make_predictions": true,
    "max_watch_streams": 2,
    "poll_interval": "120s",
    "priority": [
      "STREAK",
      "DROPS",
      "ORDER"
    ],
    "streak_watch_streams": 2,
    "team_watcher_poll_interval": "120s",
    "watch_streak": true,
    "watch_streak_minutes": 10
  },
  "delay_modes": [
    "FROM_START",
    "FROM_END",
    "PERCENTAGE"
  ],
  "filter_by": [
    "total_users",
    "total_points",
    "percentage_users",
    "odds_percentage",
    "odds",
    "top_points",
    "decision_users",
    "decision_points"
  ],
  "filter_where": [
    "GT",
    "LT",
    "GTE",
    "LTE"
  ],
  "followers_order": [
    "ASC",
    "DESC"
  ],
