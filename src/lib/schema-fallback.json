  "priorities": [
    "ORDER",
    "STREAK",
    "DROPS",
    "SUBSCRIBED",
    "POINTS_ASCENDING",
    "POINTS_DESCENDING",
    "ENDING_SOONEST",
    "LOW_AVAILABILITY_FIRST",
    "PREFERRED",
    "BADGES"
  ],
  "rules": [
    {
      "condition": "requires",
      "field": "streamer_defaults.make_predictions",
      "message": "make_predictions requires bet config",
      "target": "streamer_defaults.bet"
    },
    {
      "condition": "requires_priority",
      "field": "badge_watcher",
      "message": "badge_watcher enabled requires BADGES in priority",
      "value": "BADGES"
    },
    {
      "condition": "range",
      "field": "badge_watcher.streamer_limit",
      "max": 2,
      "message": "streamer_limit must be 1-2",
      "min": 1
    },
    {
      "condition": "min",
      "field": "max_watch_streams",
      "message": "must be non-negative",
      "value": 0
    },
    {
      "condition": "duration",
      "field": "category_watcher.poll_interval",
      "message": "must be a Go duration string"
    },
    {
      "condition": "duration",
      "field": "team_watcher.poll_interval",
      "message": "must be a Go duration string"
    },
    {
      "condition": "duration",
      "field": "badge_watcher.poll_interval",
      "message": "must be a Go duration string"
    }
  ],
  "strategies": [
    "MOST_VOTED",
    "HIGH_ODDS",
    "PERCENTAGE",
    "SMART_MONEY",
    "SMART",
    "NUMBER_1",
    "NUMBER_2",
    "NUMBER_3",
